---
import activity from '../../data/github-contributions.json'
const start = Date.parse(activity.from + 'T00:00:00Z')
const offset = new Date(start).getUTCDay()
const weeks = Math.ceil((activity.days.length + offset) / 7)
const width = 26 + weeks * 13
const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' })
const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })
const months = activity.days.flatMap((day, i) => {
  const date = new Date(day.date + 'T00:00:00Z')
  return date.getUTCDay() === 0 && date.getUTCDate() <= 7
    ? [{ label: monthFormatter.format(date), x: 26 + Math.floor((i + offset) / 7) * 13 }]
    : []
})
---

<div class='github-activity'>
  <div class='activity-heading'>
    <p><strong>{activity.total.toLocaleString('en-US')}</strong> contributions in the last year</p>
    <a href={`https://github.com/${activity.username}`}>@{activity.username} ↗</a>
  </div>
  <div class='activity-scroll' tabindex='0' role='region' aria-label='GitHub contribution calendar; scroll horizontally to explore'>
    <svg class='contribution-calendar' viewBox={`0 0 ${width} 112`} role='img' aria-labelledby='contribution-title contribution-description'>
      <title id='contribution-title'>{activity.username}'s GitHub contributions</title>
      <desc id='contribution-description'>{activity.total} contributions from {activity.from} to {activity.to}. Each square represents one day; darker green means more contributions.</desc>
      {months.map(month => <text x={month.x} y='10'>{month.label}</text>)}
      {[['Mon', 1], ['Wed', 3], ['Fri', 5]].map(([label, row]) => <text x='0' y={22 + Number(row) * 13 + 8}>{label}</text>)}
      {activity.days.map((day, i) => (
        <rect x={26 + Math.floor((i + offset) / 7) * 13} y={22 + ((i + offset) % 7) * 13} width='10' height='10' rx='2' class={`contribution-day level-${day.level}`} data-contribution-date={day.date} data-count={day.count}>
          <title>{day.count} {day.count === 1 ? 'contribution' : 'contributions'} on {dateFormatter.format(new Date(day.date + 'T00:00:00Z'))}</title>
        </rect>
      ))}
    </svg>
  </div>
  <div class='activity-footer'>
    <span>Updated {dateFormatter.format(new Date(activity.fetchedAt))}</span>
    <div class='activity-legend' aria-hidden='true'><span>Less</span>{[0, 1, 2, 3, 4].map(level => <i class={`level-${level}`} />)}<span>More</span></div>
  </div>
</div>

<style>
  .github-activity { min-width: 0; border: 1px solid hsl(var(--border)); border-radius: 1rem; padding: 1.1rem 1.2rem; }
  .activity-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem; font-size: .8rem; }
  .activity-heading strong { font-weight: 500; }
  .activity-heading a { color: hsl(var(--muted-foreground)); font-size: .75rem; }
  .activity-scroll { overflow-x: auto; margin-top: 1.1rem; padding-bottom: .25rem; border-radius: .2rem; }
  .contribution-calendar { display: block; width: 100%; min-width: 620px; }
  text { fill: hsl(var(--muted-foreground)); font: 9px system-ui, sans-serif; }
  .contribution-day { stroke: hsl(var(--foreground) / .04); stroke-width: 1; }
  .contribution-day:hover { stroke: hsl(var(--foreground)); }
  .level-0 { fill: hsl(var(--muted)); background: hsl(var(--muted)); }
  .level-1 { fill: #9be9a8; background: #9be9a8; }
  .level-2 { fill: #40c463; background: #40c463; }
  .level-3 { fill: #30a14e; background: #30a14e; }
  .level-4 { fill: #216e39; background: #216e39; }
  :global(.dark) .level-1 { fill: #0e4429; background: #0e4429; }
  :global(.dark) .level-2 { fill: #006d32; background: #006d32; }
  :global(.dark) .level-3 { fill: #26a641; background: #26a641; }
  :global(.dark) .level-4 { fill: #39d353; background: #39d353; }
  .activity-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem; margin-top: .5rem; color: hsl(var(--muted-foreground)); font-size: .65rem; }
  .activity-legend { display: flex; align-items: center; gap: 3px; }
  .activity-legend i { width: 10px; height: 10px; border-radius: 2px; outline: 1px solid hsl(var(--foreground) / .04); }
  .activity-legend span:first-child { margin-right: .3rem; }
  .activity-legend span:last-child { margin-left: .3rem; }
</style>
