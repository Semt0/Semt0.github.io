    "@waline/client": "^3.15.2",
    "astro": "6.4.8",
    "astro-pure": "1.4.9",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-directive": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "yaml": "2.9.1",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
